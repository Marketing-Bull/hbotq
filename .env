# Committed on purpose — read at build time by Vercel and by local builds.
#
# Only non-secret, public-by-design values belong here. Everything in this file
# is compiled into the client bundle or otherwise visible, and this repository
# is public. Secrets (RESEND_API_KEY, GHL_WEBHOOK_URL) go in .env.local locally
# and in Vercel's environment variables in deployed environments — both of which
# stay gitignored.
#
# Precedence: process.env wins over this file, so a value set in the Vercel
# dashboard still overrides whatever is here.

# Google Tag Manager container ID. NEXT_PUBLIC_ so it is inlined at build time;
# the ID ships in the page HTML regardless, which is why it is not a secret.
NEXT_PUBLIC_GTM_ID=GTM-N3QDS5PC
