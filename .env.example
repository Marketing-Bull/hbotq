# Resend — required in production to send consultation form leads.
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Destination inbox for consultation form leads. Falls back to site.leadEmail
# (hello@hbotq.com) when not set.
LEAD_TO_EMAIL=hello@hbotq.com

# GoHighLevel inbound webhook URL. Each consultation lead is POSTed here as JSON
# (first_name, last_name, email, phone, condition, message, source, timestamps)
# in parallel with the Resend email. Create it from an "Inbound Webhook" trigger
# in a GHL workflow. Leave unset to disable the CRM push (the email still sends).
GHL_WEBHOOK_URL=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Tag firing is no-op when
# unset, which is useful in local dev.
NEXT_PUBLIC_GTM_ID=
